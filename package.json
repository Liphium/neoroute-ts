{
	"name": "@liphium/neoroute-ts",
	"version": "1.1.1",
	"type": "module",
	"repository": {
		"type": "git",
		"directory": "https://github.com/Liphium/neoroute-ts.git",
		"url": "https://github.com/Liphium/neoroute-ts"
	},
	"homepage": "https://github.com/Liphium/neoroute-ts#readme",
	"bugs": {
		"url": "https://github.com/Liphium/neoroute-ts/issues"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"description": "Connect to Neoroute servers using WebSocket or HTTP.",
	"files": [
		"dist",
		"src"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "pnpm build",
		"format": "prettier --write .",
		"check": "prettier --check .",
		"test": "pnpm build && tsc -p tests && node --test tests/*.test.mjs",
		"test:chat": "pnpm build && tsc -p tests && pnpm --dir examples/chat_client_ws exec tsx ../../tests/chat.integration.ts",
		"test:examples": "tsc -p examples/chat_client_http --noEmit && tsc -p examples/chat_client_ws --noEmit"
	},
	"keywords": [],
	"author": "",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.4.1",
	"devDependencies": {
		"@types/node": "^26.0.1",
		"prettier": "^3.9.4",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3"
	}
}
